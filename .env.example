# lanwatch 环境变量模板
#
# 用法：
#   1) cp .env.example .env
#   2) 填入真实值（.env 已被 .gitignore 忽略，绝不会提交）
#   3) 本地运行：export $(grep -v '^#' .env | xargs) 后再启动
#      Docker 运行：docker-compose 的 env_file: .env 自动注入
#      systemd 运行：EnvironmentFile=/etc/lanwatch/lanwatch.env
#
# 注意：真实凭据请勿写入 config.yaml 或源码，一律通过环境变量注入。

# 渠道凭据加密密钥（AES-GCM 密钥派生源），必填
LANWATCH_SECRET=change-me-to-a-long-random-string

# 首次启动若 users 表为空，用该密码创建 admin（不设则随机生成并写入 initial_admin.txt）
LANWATCH_ADMIN_PASSWORD=change-me

# ASUS 路由器 SSH 密码
ASUS_PASSWORD=

# TP-Link 路由器管理密码
TPLINK_PASSWORD=
